{
  "name": "amazon-ring-recorder",
  "version": "1.0.0",
  "description": "Ring camera motion recorder",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "token:generate": "bunx ring-auth-cli",
    "deploy": "bun run scripts/deploy-remote.ts",
    "lima:generate": "tsx scripts/generate-config.ts",
    "lima:start": "bun run lima:generate -- --arch ${ARCH:-amd64} && limactl start dist/lima-${ARCH:-amd64}.yaml",
    "lima:stop": "limactl stop lima-${ARCH:-amd64} >&2 || true",
    "lima:delete": "bun run lima:stop && limactl delete lima-${ARCH:-amd64} >&2 || true",
    "lima:reset": "bun run lima:delete && bun run lima:start",
    "lima:deploy": "bun run deploy -- --host $(limactl list --format '{{.SSHAddress}}' lima-${ARCH:-amd64}) --port $(limactl list --format '{{.SSHLocalPort}}' lima-${ARCH:-amd64}) --user $(whoami) --identityFile $(limactl list --format '{{.LimaHome}}' lima-${ARCH:-amd64})/_config/user --arch ${ARCH:-amd64}",
    "lima:logs": "limactl shell lima-${ARCH:-amd64} -- bash -c 'sudo docker compose -f ~/docker-compose.yaml logs -f'"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ring-client-api": "^14.3.0",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/dockerode": "^4.0.1",
    "@types/ffmpeg-static": "^5.1.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.1.0",
    "chalk": "^5.6.2",
    "citty": "^0.2.1",
    "dockerode": "^4.0.10",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eta": "^4.5.1",
    "execa": "^9.6.1",
    "listr2": "^10.2.1",
    "node-ssh": "^13.2.1",
    "ora": "^9.3.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
