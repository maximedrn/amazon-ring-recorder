# Ring OAuth CLI.
# Required on first run. Generate with: bunx ring-auth-cli
REFRESH_TOKEN=

# Storage.
OUTPUT_DIRECTORY=
TOKEN_DIRECTORY=

# Recording.
CAMERA_POLLING_SECONDS=

# Logging.
# debug, info, warn, error
LOG_LEVEL=
# development, production, test
NODE_ENV=

# Filebrowser GUI.
FILEBROWSER_BIND=
FILEBROWSER_PORT=
FILEBROWSER_ADMIN_USER=
FILEBROWSER_ADMIN_PASSWORD=

# Notifications (self-hosted ntfy).
NTFY_URL=
NTFY_TOPIC=
NTFY_ADMIN_USER=
NTFY_ADMIN_PASSWORD=
NTFY_USER=
NTFY_PASSWORD=
NTFY_PORT=
NTFY_BASE_URL=

# Tailscale Funnel.
TAILSCALE_AUTH_KEY=
TAILSCALE_HOSTNAME=
TAILSCALE_EXTRA_ARGS=
