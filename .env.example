# Ring OAuth CLI.
# Required on first run. Generate with: bunx ring-auth-cli
REFRESH_TOKEN=

# Storage.
OUTPUT_DIRECTORY=
TOKEN_DIRECTORY=

# Recording.
CAMERA_POLLING_SECONDS=

# Logging.
# debug, info, warn, error
LOG_LEVEL=
# development, production, test
NODE_ENV=

# Filebrowser GUI.
FILEBROWSER_ADMIN_USER=
FILEBROWSER_ADMIN_PASSWORD=
FILEBROWSER_URL=
FILEBROWSER_PUBLIC_URL=
FILEBROWSER_SHARE_USER=
FILEBROWSER_SHARE_PASSWORD=

# Notifications (self-hosted ntfy).
NTFY_URL=
NTFY_TOPIC=
NTFY_ADMIN_USER=
NTFY_ADMIN_PASSWORD=
NTFY_USER=
NTFY_PASSWORD=
NTFY_BASE_URL=

# Public domains exposed through the Cloudflare Tunnel.
RING_DOMAIN=
NTFY_DOMAIN=

# Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
